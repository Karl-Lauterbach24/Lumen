<?xml version="1.0" encoding="UTF-8"?>
<!--
  Lumen – Windows-Installer (MSI), WiX Toolset 3.x. Gebaut von tools/make_msi.ps1:
    Version  Programmversion (x.y.z)
    Stage    Ordner mit dem fertigen Programm (wie im portablen ZIP) – Dateiliste in files.wxs (heat)
    Icon     lumen.ico
    License  Lizenztext als RTF für den Installationsdialog
  Der UpgradeCode bleibt für alle Versionen gleich: eine neuere Version ersetzt die
  installierte (MajorUpgrade), auch beim Update aus Lumen heraus.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Lumen" Language="1033" Version="$(var.Version)" Manufacturer="Lumen"
           UpgradeCode="6B0C1A7E-5D0F-4C56-9B5C-2F2E1E0A7C31">
    <!-- Plattform (x64/arm64) kommt von "candle -arch" -->
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine"
             Description="Lumen – Disc and Digital Cinema Player $(var.Version)" Comments="https://github.com/Karl-Lauterbach24/Lumen" />

    <MajorUpgrade Schedule="afterInstallInitialize" AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of Lumen is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="LumenIcon" SourceFile="$(var.Icon)" />
    <Property Id="ARPPRODUCTICON" Value="LumenIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Karl-Lauterbach24/Lumen" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Karl-Lauterbach24/Lumen/issues" />

    <!-- Dialoge: Willkommen, Lizenz, Zielordner, Installieren -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.License)" />
    <UIRef Id="WixUI_InstallDir" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Lumen" />
      </Directory>
      <Directory Id="ProgramMenuFolder" />
    </Directory>

    <DirectoryRef Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="C2E0B7B4-0C0A-4F0E-8B55-7B7C2F6D7A10">
        <Shortcut Id="LumenStartMenu" Name="Lumen" Description="Disc and Digital Cinema Player"
                  Target="[INSTALLFOLDER]lumen.exe" WorkingDirectory="INSTALLFOLDER" Icon="LumenIcon" />
        <RegistryValue Root="HKCU" Key="Software\Lumen\Installer" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Title="Lumen" Level="1" Absent="disallow" ConfigurableDirectory="INSTALLFOLDER">
      <ComponentGroupRef Id="LumenFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Product>
</Wix>
