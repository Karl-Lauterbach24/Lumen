 static void uninit(struct ao *ao)
 {
+    struct priv *priv = ao->priv;
+
+    tap_record(ao, TAP_RESET, mp_time_ns() / 1000, NULL, 0);
+    if (priv->fp)
+        fclose(priv->fp);
+    priv->fp = NULL;
 }
 
