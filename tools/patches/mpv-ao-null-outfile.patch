+// Record layout (native byte order), followed by the samples for TAP_DATA
+// (interleaved, format/rate/channels as negotiated):
+//   char magic[4] "LAO1"; uint32 type; int64 time_us; uint32 samples; uint32 reserved
+// time_us is in the time base of mpv_get_time_us(). For TAP_DATA it is the
+// moment the first sample of the block is played; otherwise the current time.
+enum { TAP_DATA = 1, TAP_PAUSE = 2, TAP_RESUME = 3, TAP_RESET = 4 };
+
+static void tap_record(struct ao *ao, uint32_t type, int64_t time_us,
+                       void *data, uint32_t samples)
+{
+    struct priv *priv = ao->priv;
+    if (!priv->fp)
+        return;
+    unsigned char head[24] = {'L', 'A', 'O', '1'};
+    uint32_t reserved = 0;
+    memcpy(head + 4, &type, 4);
+    memcpy(head + 8, &time_us, 8);
+    memcpy(head + 16, &samples, 4);
+    memcpy(head + 20, &reserved, 4);
+    fwrite(head, sizeof(head), 1, priv->fp);
+    if (data && samples)
+        fwrite(data, ao->sstride, samples, priv->fp);
+    fflush(priv->fp);
+}
+
