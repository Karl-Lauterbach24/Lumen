+/* The loops below are written to be vectorized; GCC only does that for loops
+ * of unknown length from -O3 on. */
+#if defined(__GNUC__) && !defined(__clang__)
+#define DWT_VECTORIZE __attribute__((optimize("O3")))
+#else
+#define DWT_VECTORIZE
+#endif
