+/**
+ * sr_1d97_float() on FF_DWT_BLOCK columns at once: p[i * FF_DWT_BLOCK + c] is
+ * sample i of column c. Every column sees the same operations in the same
+ * order as in sr_1d97_float(), so the results are identical; the loops over c
+ * run over neighbouring memory and vectorize.
+ * Only for i1 - i0 >= 5 (the extension reads up to four samples inwards).
+ */
+static DWT_VECTORIZE void sr_1d97_float_block(float *p, int i0, int i1, int n)
+{
+    int i, c;
+
+    for (i = 1; i <= 4; i++) {
+        memcpy(p + (i0 - i) * FF_DWT_BLOCK,     p + (i0 + i) * FF_DWT_BLOCK,     n * sizeof(*p));
+        memcpy(p + (i1 + i - 1) * FF_DWT_BLOCK, p + (i1 - i - 1) * FF_DWT_BLOCK, n * sizeof(*p));
+    }
+
+#define LIFT(first, last, target, OP, K)                                      \
+    for (i = (first); i < (last); i++) {                                      \
+        float *d       = p + (2 * i + (target)) * FF_DWT_BLOCK;               \
+        const float *a = d - FF_DWT_BLOCK;                                    \
+        const float *b = d + FF_DWT_BLOCK;                                    \
+        for (c = 0; c < n; c++)                                               \
+            d[c] OP K * (a[c] + b[c]);                                        \
+    }
+
+    LIFT((i0 >> 1) - 1, (i1 >> 1) + 2, 0, -=, F_LFTG_DELTA)
+    LIFT((i0 >> 1) - 1, (i1 >> 1) + 1, 1, -=, F_LFTG_GAMMA)
+    LIFT((i0 >> 1),     (i1 >> 1) + 1, 0, +=, F_LFTG_BETA)
+    LIFT((i0 >> 1),     (i1 >> 1),     1, +=, F_LFTG_ALPHA)
+#undef LIFT
+}
+
+/**
+ * sr_1d97_float() with the even samples (low band) in e[] and the odd ones
+ * (high band) in o[]: p[2 * i] is e[i], p[2 * i + 1] is o[i]. That is how the
+ * coefficients lie in the picture anyway, and the lifting steps run over
+ * neighbouring memory. Same operations in the same order as sr_1d97_float().
+ * Only for i1 - i0 >= 5.
+ */
+static inline float *split_sample(float *e, float *o, int x)
+{
+    return (x & 1) ? o + (x - 1) / 2 : e + x / 2;
+}
+
+static DWT_VECTORIZE void sr_1d97_float_split(float *e, float *o, int i0, int i1)
+{
+    int i;
+
+    for (i = 1; i <= 4; i++) {
+        *split_sample(e, o, i0 - i)     = *split_sample(e, o, i0 + i);
+        *split_sample(e, o, i1 + i - 1) = *split_sample(e, o, i1 - i - 1);
+    }
+
+    for (i = (i0 >> 1) - 1; i < (i1 >> 1) + 2; i++)
+        e[i] -= F_LFTG_DELTA * (o[i - 1] + o[i]);
+    for (i = (i0 >> 1) - 1; i < (i1 >> 1) + 1; i++)
+        o[i] -= F_LFTG_GAMMA * (e[i] + e[i + 1]);
+    for (i = (i0 >> 1); i < (i1 >> 1) + 1; i++)
+        e[i] += F_LFTG_BETA  * (o[i - 1] + o[i]);
+    for (i = (i0 >> 1); i < (i1 >> 1); i++)
+        o[i] += F_LFTG_ALPHA * (e[i] + e[i + 1]);
+}
