tzdata
ca-certificates
curl
jq
less
nano
procps
iproute2
iputils-ping
pciutils
usbutils
rfkill
util-linux
unattended-upgrades
initramfs-tools
zstd
unzip

# --- firmware (network, graphics, sound) and microcode
