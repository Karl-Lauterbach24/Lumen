#!/bin/sh
# Runs inside the image while it is built: Lumen is installed, now make the system its player.
set -e
/usr/share/lumen/os/lumenos-setup install

# English as the system's language until the user chooses another in Lumen; UTF-8 everywhere
sed -i 's/^# *en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen
locale-gen > /dev/null 2>&1 || true
printf 'LANG=en_US.UTF-8\n' > /etc/default/locale
echo lumenos > /etc/hostname
printf '127.0.0.1\tlocalhost\n127.0.1.1\tlumenos\n' > /etc/hosts

# NetworkManager looks after every interface (a cable is taken by itself)
mkdir -p /etc/NetworkManager/conf.d
printf '[main]\nplugins=keyfile\n[ifupdown]\nmanaged=true\n[device]\nwifi.scan-rand-mac-address=no\n' > /etc/NetworkManager/conf.d/lumenos.conf
rm -f /etc/network/interfaces.d/* 2> /dev/null || true

# Debian's security updates install themselves
printf 'APT::Periodic::Update-Package-Lists "1";\nAPT::Periodic::Unattended-Upgrade "1";\n' > /etc/apt/apt.conf.d/20auto-upgrades

# what a player does not need
systemctl mask systemd-networkd-wait-online.service > /dev/null 2>&1 || true
systemctl disable ModemManager.service > /dev/null 2>&1 || true
apt-get clean
rm -rf /var/lib/apt/lists/* /usr/share/doc/*/changelog* /usr/share/man/??_* 2> /dev/null || true
exit 0
