#!/bin/bash
# LumenOS: what the player needs done with the system's rights. Lumen runs as an ordinary user and
# calls this through sudo (the rule is written by lumenos-setup); nothing else of the system is
# open to it. Every verb checks what it is given.
#
# Output is for the settings pages: lines of fields separated by tabs, or key=value.
set -u
export LC_ALL=C
PATH=/usr/sbin:/usr/bin:/sbin:/bin
HERE=/usr/share/lumen/os
USER_NAME=lumen
SHARES=/etc/lumenos/shares
# what the image carries without installing it: the user is asked first (Settings › Discs)
OPTIONAL=/usr/share/lumenos-optional

die() { echo "$*" >&2; exit 1; }
name_ok() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,60}$ ]]; }
user_home() { getent passwd "$USER_NAME" | cut -d: -f6; }

verb="${1:-}"
[ $# -gt 0 ] && shift

case "$verb" in

# ------------------------------------------------------------------ power
power)
    case "${1:-}" in
    reboot) systemctl --no-block reboot ;;
    poweroff) systemctl --no-block poweroff ;;
    restart) systemctl --no-block restart lumenos-session.service ;;
    *) die "power reboot|poweroff|restart" ;;
    esac
    ;;

# ------------------------------------------------------------------ the display for a film
vt)
    # A film goes straight to the display, without the window system - only so the display learns
    # of HDR and takes the film's frame rate. The window system has to let go of the display for
    # that: the console is switched to one of its own ("film"), and back afterwards ("ui").
    # (perl is part of every Debian; the two calls are VT_ACTIVATE and VT_WAITACTIVE.)
    switch_to() {
        perl -e 'open(my $t, "<", "/dev/tty0") or exit 1; my $n = $ARGV[0] + 0;
                 ioctl($t, 0x5606, $n) or exit 1; ioctl($t, 0x5607, $n) or exit 1;' "$1"
    }
    film=8
    case "${1:-}" in
    film)
        now="$(sed 's/^tty//' /sys/class/tty/tty0/active 2> /dev/null)"
        [ "$now" = "$film" ] && exit 0
        mkdir -p /run/lumenos
        echo "${now:-1}" > /run/lumenos/vt
        # an empty console: no cursor, nothing written on it
        printf '\033[?25l\033[2J\033[H' > "/dev/tty$film" 2> /dev/null || true
        switch_to "$film" || die "the console could not be switched"
        ;;
    ui)
        back="$(cat /run/lumenos/vt 2> /dev/null)"
        case "$back" in '' | *[!0-9]*) back=1 ;; esac
        now="$(sed 's/^tty//' /sys/class/tty/tty0/active 2> /dev/null)"
        # (someone switched to another console by hand: leave him there)
        [ "$now" = "$film" ] || exit 0
        switch_to "$back" || die "the console could not be switched"
        ;;
    *) die "vt film|ui" ;;
    esac
    ;;

# ------------------------------------------------------------------ installing to the internal disk
install-list)
    "$HERE/lumenos-install" list
    ;;
install-to)
    "$HERE/lumenos-install" to "${1:-}" || exit 1
    ;;

# ------------------------------------------------------------------ disc
eject)
    drive="$(basename "${1:-}")"
    [[ "$drive" =~ ^sr[0-9]+$ ]] || die "eject <drive>"
    "$HERE/lumenos-disc" "$drive" eject
    ;;

# ------------------------------------------------------------------ update
update-now)
    # (a second request while one runs finds the unit there and does nothing)
    systemd-run --quiet --collect --unit=lumenos-update-now "$HERE/lumenos-update" --now 2> /dev/null || true
    ;;
update-auto)
    conf=/etc/lumenos/update.conf
    case "${1:-status}" in
    on | off)
        printf '%s\n' "AUTO=$1" > "$conf"
        ;;
    status)
        AUTO=on
        [ -r "$conf" ] && . "$conf"
        echo "$AUTO"
        ;;
    *) die "update-auto on|off|status" ;;
    esac
    ;;

offline-scan)
    "$HERE/lumenos-offline" scan
    ;;
offline-install)
    "$HERE/lumenos-offline" install "${1:-}" || exit 1
    ;;

# ------------------------------------------------------------------ first start
setup-info)
    # what the setup needs to know: started from an image? a network there?
    [ -f /run/live/medium/live/filesystem.squashfs ] && echo live=yes || echo live=no
    if nmcli -t -f CONNECTIVITY general 2> /dev/null | grep -q full || curl -fsI --max-time 6 https://api.github.com > /dev/null 2>&1; then echo online=yes; else echo online=no; fi
    ;;
set-timezone)
    zone="${1:-}"
    [ -f "/usr/share/zoneinfo/$zone" ] && [[ "$zone" =~ ^[A-Za-z0-9_+/-]+$ ]] || die "set-timezone <zone>"
    timedatectl set-timezone "$zone"
    ;;

# ------------------------------------------------------------------ network
wifi-list)
    command -v nmcli > /dev/null || die "NetworkManager is not installed"
    nmcli radio wifi on > /dev/null 2>&1
    # terse output separates with ':' and escapes the ones inside a name with a backslash
    nmcli -t -f IN-USE,SIGNAL,SECURITY,SSID device wifi list --rescan auto 2> /dev/null \
        | awk '{
            line = $0; gsub(/\\:/, "\001", line)
            n = split(line, f, ":")
            ssid = f[4]; for (i = 5; i <= n; i++) ssid = ssid ":" f[i]
            gsub(/\001/, ":", ssid)
            if (ssid == "") next
            if (!(ssid in best) || f[2] + 0 > best[ssid] + 0) { best[ssid] = f[2]; sec[ssid] = f[3]; use[ssid] = (f[1] == "*") ? "yes" : (use[ssid] == "yes" ? "yes" : "no") }
          }
          END { for (s in best) printf "%s\t%s\t%s\t%s\n", s, best[s], (sec[s] == "" ? "--" : sec[s]), use[s] }' \
        | sort -t "$(printf '\t')" -k4,4r -k2,2nr
    ;;
wifi-connect)
    ssid="${1:-}"
    password="${2:-}"
    [ -n "$ssid" ] || die "wifi-connect <network> [password]"
    if [ -n "$password" ]; then
        nmcli --wait 40 device wifi connect "$ssid" password "$password" || { nmcli connection delete id "$ssid" > /dev/null 2>&1; exit 1; }
    else
        nmcli --wait 40 device wifi connect "$ssid" || exit 1
    fi
    ;;

# ------------------------------------------------------------------ network shares
share-list)
    for conf in "$SHARES"/*.conf; do
        [ -r "$conf" ] || continue
        TYPE="" SOURCE=""
        . "$conf"
        name="$(basename "$conf" .conf)"
        mounted=no
        awk -v d="/mnt/shares/$name" '$2 == d { found = 1 } END { exit !found }' /proc/mounts && mounted=yes
        printf '%s\t%s\t%s\t%s\n' "$name" "$TYPE" "$SOURCE" "$mounted"
    done
    ;;
share-add)
    name="${1:-}" type="${2:-}" host="${3:-}" path="${4:-}" user="${5:-}" password="${6:-}"
    name_ok "$name" || die "the name may hold letters, digits, dot, dash and underscore"
    [[ "$host" =~ ^[A-Za-z0-9._:-]+$ ]] || die "not a host name or address: $host"
    [ -n "$path" ] || die "share-add <name> smb|nfs <host> <share> [user] [password]"
    mkdir -p "$SHARES" "/mnt/shares/$name"
    dir="/mnt/shares/$name"
    case "$type" in
    smb)
        source="//$host/${path#/}"
        cred="$SHARES/$name.cred"
        ( umask 077; printf 'username=%s\npassword=%s\n' "${user:-guest}" "$password" > "$cred" )
        fstype=cifs
        options="credentials=$cred,uid=$USER_NAME,gid=$USER_NAME,file_mode=0664,dir_mode=0775,iocharset=utf8,nofail,_netdev"
        [ -n "$user" ] || options="$options,guest"
        ;;
    nfs)
        source="$host:/${path#/}"
        fstype=nfs
        options="rw,soft,timeo=100,nofail,_netdev"
        ;;
    *) die "smb or nfs" ;;
    esac
    # try it once now: what does not mount is not kept
    if ! mount -t "$fstype" -o "$options" "$source" "$dir" 2> /tmp/lumenos-mount.$$; then
        err="$(tail -1 /tmp/lumenos-mount.$$)"
        rm -f /tmp/lumenos-mount.$$ "$SHARES/$name.cred"
        rmdir "$dir" 2> /dev/null
        die "${err:-mount failed}"
    fi
    rm -f /tmp/lumenos-mount.$$
    umount "$dir" 2> /dev/null
    printf 'TYPE=%s\nSOURCE=%q\n' "$type" "$source" > "$SHARES/$name.conf"
    # mounted when first looked into, and again after the network was away
    unit="$(systemd-escape -p --suffix=mount "$dir")"
    auto="$(systemd-escape -p --suffix=automount "$dir")"
    cat > "/etc/systemd/system/$unit" << UNIT
[Unit]
Description=LumenOS share $name
[Mount]
What=$source
Where=$dir
Type=$fstype
Options=$options
TimeoutSec=20
UNIT
    cat > "/etc/systemd/system/$auto" << UNIT
[Unit]
Description=LumenOS share $name
[Automount]
Where=$dir
TimeoutIdleSec=0
[Install]
WantedBy=multi-user.target
UNIT
    systemctl daemon-reload
    systemctl enable --now "$auto" > /dev/null 2>&1
    ls "$dir" > /dev/null 2>&1 || true
    ;;
share-remove)
    name="${1:-}"
    name_ok "$name" || die "share-remove <name>"
    dir="/mnt/shares/$name"
    unit="$(systemd-escape -p --suffix=mount "$dir")"
    auto="$(systemd-escape -p --suffix=automount "$dir")"
    systemctl disable --now "$auto" > /dev/null 2>&1
    systemctl stop "$unit" > /dev/null 2>&1
    umount -l "$dir" 2> /dev/null
    rm -f "/etc/systemd/system/$unit" "/etc/systemd/system/$auto" "$SHARES/$name.conf" "$SHARES/$name.cred"
    rmdir "$dir" 2> /dev/null
    systemctl daemon-reload
    ;;

# ------------------------------------------------------------------ Bluetooth
bt-scan)
    seconds="${1:-10}"
    [[ "$seconds" =~ ^[0-9]+$ ]] && [ "$seconds" -le 60 ] || seconds=10
    command -v bluetoothctl > /dev/null || die "Bluetooth is not installed"
    rfkill unblock bluetooth 2> /dev/null
    bluetoothctl power on > /dev/null 2>&1 || die "no Bluetooth adapter"
    bluetoothctl --timeout "$seconds" scan on > /dev/null 2>&1
    bluetoothctl devices 2> /dev/null | while read -r _ mac name; do
        [[ "$mac" =~ ^[0-9A-F:]{17}$ ]] || continue
        info="$(bluetoothctl info "$mac" 2> /dev/null)"
        paired=no connected=no
        grep -q 'Paired: yes' <<< "$info" && paired=yes
        grep -q 'Connected: yes' <<< "$info" && connected=yes
        # devices that only show an address are mostly not what one wants to pair; list them last
        printf '%s\t%s\t%s\t%s\n' "$mac" "${name:-$mac}" "$paired" "$connected"
    done | sort -t "$(printf '\t')" -k3,3r -k2,2
    ;;
bt-pair)
    mac="${1:-}"
    [[ "$mac" =~ ^[0-9A-Fa-f:]{17}$ ]] || die "bt-pair <address>"
    bluetoothctl power on > /dev/null 2>&1
    # remotes and gamepads pair without a number; a keyboard that wants one typed is not handled here
    out="$(printf 'agent NoInputNoOutput\ndefault-agent\n' | bluetoothctl 2>&1; bluetoothctl --timeout 25 pair "$mac" 2>&1)"
    bluetoothctl info "$mac" 2> /dev/null | grep -q 'Paired: yes' || die "$(tail -1 <<< "$out")"
    bluetoothctl trust "$mac" > /dev/null 2>&1
    bluetoothctl --timeout 15 connect "$mac" > /dev/null 2>&1 || true
    ;;
bt-remove)
    mac="${1:-}"
    [[ "$mac" =~ ^[0-9A-Fa-f:]{17}$ ]] || die "bt-remove <address>"
    bluetoothctl remove "$mac" > /dev/null 2>&1
    ;;

# ------------------------------------------------------------------ HDMI-CEC
cec-setup)
    # Announce this device to the television as a player. From then on the kernel hands the keys
    # of the television's remote on as an input device, which Lumen sets up like any other remote.
    command -v cec-ctl > /dev/null || exit 0
    for dev in /dev/cec[0-9]*; do
        [ -e "$dev" ] || continue
        cec-ctl -d "$dev" --playback --osd-name LumenOS > /dev/null 2>&1 || true
    done
    ;;

# ------------------------------------------------------------------ discs: what the user may add
support-status)
    home="$(user_home)"
    ldconfig -p | grep -q 'libaacs\.so' && echo aacs=yes || echo aacs=no
    if [ -s "$home/.config/aacs/KEYDB.cfg" ]; then
        echo keydb=yes
        echo "keydb_date=$(date -r "$home/.config/aacs/KEYDB.cfg" +%Y-%m-%d)"
    else
        echo keydb=no
    fi
    systemctl is-enabled lumenos-keydb.timer > /dev/null 2>&1 && echo keydb_auto=yes || echo keydb_auto=no
    [ -s "$OPTIONAL/keydb.zip" ] && echo keydb_bundled=yes || echo keydb_bundled=no
    ls "$OPTIONAL"/libdvdcss2_*.deb > /dev/null 2>&1 && echo dvdcss_bundled=yes || echo dvdcss_bundled=no
    ldconfig -p | grep -q 'libdvdcss\.so' && echo dvdcss=yes || echo dvdcss=no
    if command -v makemkvcon > /dev/null 2>&1; then
        # the version the setup noted (makemkvcon is not asked: it would look at the drives);
        # "yes" for a MakeMKV that came another way
        version="$(head -c 20 /var/lib/lumenos/makemkv-version 2> /dev/null | tr -cd '0-9.')"
        echo "makemkv=${version:-yes}"
    else
        echo makemkv=
    fi
    ;;
keydb-fetch)
    # The key database for Blu-rays that its community keeps (the address stands in
    # /etc/lumenos/keydb.url). Asked for by the user in the setup or in the settings; kept current
    # once a week from then on (lumenos-keydb.timer).
    url="$(grep -v '^#' /etc/lumenos/keydb.url 2> /dev/null | head -1)"
    [ -n "$url" ] || url="http://fvonline-db.bplaced.net/export/keydb_eng.zip"
    home="$(user_home)"
    work="$(mktemp -d /var/tmp/lumenos-keydb.XXXXXX)"
    trap 'rm -rf "$work"' EXIT
    from="$url"
    if ! curl -fsSL --retry 2 --max-time 600 -o "$work/keydb.zip" "$url"; then
        # No network: the image carries the database as it was on the day the image was made
        # (not installed until asked for). An installed one is left alone - it is not older.
        [ -s "$home/.config/aacs/KEYDB.cfg" ] && die "the key database could not be refreshed (no network?)"
        [ -s "$OPTIONAL/keydb.zip" ] || die "the key database could not be loaded (no network?)"
        cp "$OPTIONAL/keydb.zip" "$work/keydb.zip"
        from="the image"
    fi
    unzip -q -o "$work/keydb.zip" -d "$work" 2> /dev/null || cp "$work/keydb.zip" "$work/keydb.cfg"
    cfg="$(find "$work" -maxdepth 2 -iname 'keydb.cfg' | head -1)"
    [ -s "$cfg" ] && grep -qm1 '|' "$cfg" || die "what came from $from is not a key database"
    install -d -o "$USER_NAME" -g "$USER_NAME" "$home/.config/aacs"
    install -o "$USER_NAME" -g "$USER_NAME" -m 600 "$cfg" "$home/.config/aacs/KEYDB.cfg"
    systemctl enable --now lumenos-keydb.timer > /dev/null 2>&1 || true
    echo "keys for $(grep -c '^0x' "$home/.config/aacs/KEYDB.cfg") discs"
    ;;
keydb-remove)
    home="$(user_home)"
    systemctl disable --now lumenos-keydb.timer > /dev/null 2>&1 || true
    rm -f "$home/.config/aacs/KEYDB.cfg"
    ;;
keydb-import)
    # the user's own key file from a storage device he plugged in
    home="$(user_home)"
    for file in "$@"; do
        case "$(readlink -f "$file" 2> /dev/null)" in /media/*) ;; *) continue ;; esac
        [ -s "$file" ] || continue
        install -d -o "$USER_NAME" -g "$USER_NAME" "$home/.config/aacs"
        install -o "$USER_NAME" -g "$USER_NAME" -m 600 "$file" "$home/.config/aacs/KEYDB.cfg"
        exit 0
    done
    die "no KEYDB.cfg in the top folder of a plugged-in storage device"
    ;;
install-dvdcss)
    export DEBIAN_FRONTEND=noninteractive
    log=/tmp/lumenos-dvdcss.log
    # The image carries the library as a package that is not installed (built when the image was made);
    # asked for, it is installed from there – no network needed.
    bundled="$(ls "$OPTIONAL"/libdvdcss2_*.deb 2> /dev/null | head -1)"
    if [ -n "$bundled" ]; then
        if dpkg -i "$bundled" > "$log" 2>&1; then
            ldconfig
            exit 0
        fi
        # not a package this system takes: nothing stays half installed, and the long way is tried
        dpkg -P libdvdcss2 >> "$log" 2>&1 || true
    fi
    # Without it, Debian's own way: its package libdvd-pkg loads the source of libdvdcss from VideoLAN
    # and builds it on this machine
    grep -rqs '\bcontrib\b' /etc/apt/sources.list /etc/apt/sources.list.d/ || die "the package source 'contrib' is not enabled"
    apt-get update -q >> "$log" 2>&1 || die "libdvdcss has to be loaded, and there is no network"
    echo 'libdvd-pkg libdvd-pkg/first-install note' | debconf-set-selections
    echo 'libdvd-pkg libdvd-pkg/post-invoke_hook-install boolean true' | debconf-set-selections
    echo 'libdvd-pkg libdvd-pkg/build boolean true' | debconf-set-selections
    apt-get install -y -q libdvd-pkg >> "$log" 2>&1 || die "libdvdcss could not be set up (see $log)"
    dpkg-reconfigure -f noninteractive libdvd-pkg >> "$log" 2>&1 || die "libdvdcss could not be built (see $log)"
    ldconfig
    ldconfig -p | grep -q 'libdvdcss\.so' || die "libdvdcss was not built (see $log)"
    ;;
install-makemkv)
    "$HERE/lumenos-makemkv" install || exit 1
    ;;
remove-dvdcss)
    export DEBIAN_FRONTEND=noninteractive
    apt-get purge -y -q libdvdcss2 libdvd-pkg > /dev/null 2>&1 || dpkg -P libdvdcss2 > /dev/null 2>&1
    ldconfig
    ;;
makemkv-key)
    key="${1:-}"
    [[ "$key" =~ ^[TM]-[A-Za-z0-9@_]{40,80}$ ]] || die "this does not look like a MakeMKV key"
    "$HERE/lumenos-makemkv" key "$key"
    ;;
makemkv-betakey)
    "$HERE/lumenos-makemkv" betakey
    ;;

*)
    die "lumenos-admin: unknown request '$verb'"
    ;;
esac
