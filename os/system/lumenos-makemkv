#!/bin/bash
# LumenOS: MakeMKV, when the user asks for it in the settings (Discs).
#
#   lumenos-makemkv install    load MakeMKV's two official packages from makemkv.com and build them here
#   lumenos-makemkv version    the version that would be loaded
#   lumenos-makemkv key <key>  enter a licence key
#   lumenos-makemkv betakey    enter the beta key its author posts in MakeMKV's forum
#
# MakeMKV is GuinpinSoft's program with a licence of its own (https://www.makemkv.com/eula); the
# settings page says so before this runs. Nothing of it is part of LumenOS: it is loaded and built
# on this device.
set -u
export LC_ALL=C DEBIAN_FRONTEND=noninteractive
LOG=/var/log/lumenos-makemkv.log
USER_NAME=lumen
SITE="${LUMENOS_MAKEMKV_SITE:-https://www.makemkv.com}"
LINUX_PAGE="${LUMENOS_MAKEMKV_LINUX_PAGE:-https://forum.makemkv.com/forum/viewtopic.php?f=3&t=224}"
KEY_PAGE="${LUMENOS_MAKEMKV_KEY_PAGE:-https://forum.makemkv.com/forum/viewtopic.php?f=5&t=1053}"
AGENT='Mozilla/5.0 (LumenOS)'
VERSION_FILE=/var/lib/lumenos/makemkv-version
BEFORE=/var/lib/lumenos/makemkv-before

die() { echo "$*" >&2; exit 1; }
home() { getent passwd "$USER_NAME" | cut -d: -f6; }

set_key() {
    key="$1"
    dir="$(home)/.MakeMKV"
    install -d -o "$USER_NAME" -g "$USER_NAME" "$dir"
    conf="$dir/settings.conf"
    touch "$conf"
    # one line 'app_Key = "…"'; the rest of the file is MakeMKV's
    grep -v '^[[:space:]]*app_Key' "$conf" > "$conf.new" || true
    printf 'app_Key = "%s"\n' "$key" >> "$conf.new"
    mv "$conf.new" "$conf"
    chown "$USER_NAME:$USER_NAME" "$conf"
    chmod 600 "$conf"
}

# The current version. MakeMKV's post for Linux in its forum names the two packages; the download
# page names the installers for Windows and macOS, which carry the same number. Whichever answers.
current_version() {
    local page version="" reached=""
    if page="$(curl -fsSL --max-time 40 -A "$AGENT" "$LINUX_PAGE" 2> /dev/null)"; then
        reached=1
        version="$(grep -o 'makemkv-oss-[0-9][0-9.]*\.tar\.gz' <<< "$page" | sed 's/makemkv-oss-//; s/\.tar\.gz//' | sort -V | tail -1)"
    fi
    if [ -z "$version" ] && page="$(curl -fsSL --max-time 40 -A "$AGENT" "$SITE/download/" 2> /dev/null)"; then
        reached=1
        version="$(grep -oE '(Setup_MakeMKV_v|makemkv_v)[0-9]+(\.[0-9]+)+' <<< "$page" | sed -E 's/^[^0-9]*//' | sort -V | tail -1)"
    fi
    [ -n "$reached" ] || die "makemkv.com cannot be reached"
    [[ "$version" =~ ^[0-9]+(\.[0-9]+)+$ ]] || die "makemkv.com names no current version"
    echo "$version"
}

# what MakeMKV consists of on this system
parts() { ls /usr/bin/makemkvcon /usr/lib/libmakemkv.so.* /usr/lib/libdriveio.so.* /usr/lib/libmmbd.so.* 2> /dev/null; }

# The packages of the libraries these link to: marked as wanted, so that removing the build tools
# (which brought some of them along) leaves them in place.
keep_libraries() {
    local lib packages
    packages="$(for lib in $(parts | xargs -r ldd 2> /dev/null | awk '$2 == "=>" && $3 ~ /^\// { print $3 }' | sort -u); do
        dpkg -S "$(readlink -f "$lib")" 2> /dev/null | cut -d: -f1
    done | sort -u)"
    [ -z "$packages" ] || apt-mark manual $packages
}

# The build tools are not needed any more. What the build step added is marked as "came along", the
# libraries MakeMKV runs with as wanted, and then everything of the added that nothing wanted depends
# on is removed – also what is merely recommended by something else (a compiler recommended by a
# packaging tool would stay otherwise). Packages that were there before are not touched.
remove_build_tools() {
    local added removable mine
    added="$(dpkg-query -W -f '${Package}\n' | sort -u | comm -13 "$BEFORE" -)"
    rm -f "$BEFORE"
    [ -n "$added" ] || return 0
    apt-mark auto $added > /dev/null
    keep_libraries
    removable="$(apt-get -s -o APT::AutoRemove::RecommendsImportant=false -o APT::AutoRemove::SuggestsImportant=false autoremove 2> /dev/null \
        | awk '$1 == "Remv" { sub(/:.*/, "", $2); print $2 }' | sort -u)"
    mine="$(comm -12 <(echo "$removable") <(echo "$added"))"
    [ -z "$mine" ] || apt-get purge -y -q $mine || true
    # the downloaded package files
    apt-get clean
}

missing_libraries() { parts | xargs -r ldd 2> /dev/null | awk '/not found/ { print $1 }' | sort -u | tr '\n' ' ' | sed 's/ $//'; }

case "${1:-}" in
version)
    current_version
    ;;
install)
    version="$(current_version)" || exit 1
    # what is installed before the build tools come: afterwards exactly what they added goes again
    mkdir -p "$(dirname "$BEFORE")"
    dpkg-query -W -f '${Package}\n' | sort -u > "$BEFORE"
    {
        echo "=== $(date) MakeMKV $version"
        apt-get update -q
        apt-get install -y -q --no-install-recommends build-essential pkg-config libc6-dev libssl-dev libexpat1-dev zlib1g-dev libavcodec-dev
    } > "$LOG" 2>&1 || die "the build tools could not be installed (see $LOG)"
    work="$(mktemp -d)"
    trap 'rm -rf "$work"' EXIT
    for part in oss bin; do
        curl -fsSL --retry 2 --max-time 600 -o "$work/makemkv-$part.tar.gz" "$SITE/download/makemkv-$part-$version.tar.gz" >> "$LOG" 2>&1 \
            || die "makemkv-$part-$version could not be loaded"
    done
    (
        set -e
        cd "$work"
        tar -xzf makemkv-oss.tar.gz
        tar -xzf makemkv-bin.tar.gz
        cd "$work"/makemkv-oss-*
        ./configure --prefix=/usr --disable-gui
        make -j"$(nproc)"
        make install
        cd "$work"/makemkv-bin-*
        mkdir -p tmp
        echo accepted > tmp/eula_accepted
        make PREFIX=/usr install
        ldconfig
    ) >> "$LOG" 2>&1 || die "the build failed (see $LOG)"
    command -v makemkvcon > /dev/null || die "the build left no makemkvcon (see $LOG)"
    # (makemkvcon has no switch that names its version; asking it any other way makes it look at the drives)
    mkdir -p "$(dirname "$VERSION_FILE")"
    echo "$version" > "$VERSION_FILE"
    remove_build_tools >> "$LOG" 2>&1
    if missing="$(missing_libraries)" && [ -n "$missing" ]; then
        die "MakeMKV is built, but libraries it needs are missing: $missing (see $LOG)"
    fi
    echo "MakeMKV $version"
    ;;
key)
    [ -n "${2:-}" ] || die "key <key>"
    set_key "$2"
    ;;
betakey)
    page="$(curl -fsSL --max-time 40 -A 'Mozilla/5.0 (LumenOS)' "$KEY_PAGE" 2> /dev/null)" || die "MakeMKV's forum cannot be reached"
    key="$(grep -o 'T-[A-Za-z0-9@_]\{60,70\}' <<< "$page" | head -1)"
    [ -n "$key" ] || die "the forum page shows no beta key right now"
    set_key "$key"
    echo "beta key entered"
    ;;
*)
    die "lumenos-makemkv install | version | key <key> | betakey"
    ;;
esac
