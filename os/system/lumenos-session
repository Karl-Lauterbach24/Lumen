#!/bin/sh
# LumenOS: the one session of the device. A Wayland compositor that shows a single program
# (cage), and in it Lumen as a player ("--os"). Started by lumenos-session.service on tty1;
# when Lumen ends for whatever reason, systemd starts this again.
set -u
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export XDG_SESSION_TYPE=wayland
export QT_QPA_PLATFORM=wayland
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export LUMEN_OS=1
# no pointer on the television until a mouse moves
export XCURSOR_SIZE=32
[ -r /etc/lumenos/session.env ] && . /etc/lumenos/session.env

# Disc libraries the user has set up on this device (settings, "Discs"). Lumen brings none itself.
dvdcss="$(/sbin/ldconfig -p 2> /dev/null | awk '/libdvdcss\.so\.2/ { print $NF; exit }')"
[ -n "$dvdcss" ] && export LUMEN_DVDCSS_LIBRARY="$dvdcss"
# Blu-ray: with a key file of the user the system's libaacs reads it; without one, MakeMKV's
# library takes that place if MakeMKV was set up
if [ ! -s "${HOME:-/home/lumen}/.config/aacs/KEYDB.cfg" ] && [ -e /usr/lib/libmmbd.so.0 ]; then
    export LIBAACS_PATH=/usr/lib/libmmbd LIBBDPLUS_PATH=/usr/lib/libmmbd
fi

# sound: PipeWire and its session manager run as services of this user; make sure they are up
# before the player asks for its output (a connection that fails is slower than one that waits)
if command -v systemctl > /dev/null 2>&1; then
    systemctl --user start pipewire.socket wireplumber.service > /dev/null 2>&1 || true
fi

# -s: the keys for switching the console stay (Ctrl+Alt+F2 for a login, for maintenance)
# -d: no window decorations
exec cage -s -d -- /usr/bin/lumen --os
